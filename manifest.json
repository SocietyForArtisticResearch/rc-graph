{
  "manifest_version": 2,
  "name": "rcGraph",
  "version": "0.1.1",
  "description": "Annotate relationships between tools in a research catalogue and export to Neo4j.",
  "permissions": ["storage", "activeTab", "<all_urls>"],
  "background": {
    "scripts": ["src/shared.js", "src/background.js"]
  },
  "browser_action": {
    "default_title": "rcGraph",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rcgraph@example.com",
      "data_collection_permissions": {
        "collect": false,
        "required": ["none"]
      }
    }
  }
}